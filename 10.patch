+function handlePaneVote(paneIndex, btn) {
+  var wrap = btn.closest('.pane-fb-vote');
+  if (!wrap) return;
+  var val = btn.dataset.val;
+  wrap.querySelectorAll('.feedback-btn').forEach(function(b) { b.classList.remove('active'); });
+  btn.classList.add('active');
+  var savedEl = document.getElementById('pane-vote-saved-' + (paneIndex + 1));
+  if (savedEl) savedEl.textContent = (val === 'like' ? '👍' : '👎') + ' Đã ghi nhận';
+  var commentEl = document.getElementById('pane-fb-comment-' + (paneIndex + 1));
+  if (commentEl) {
+    commentEl.style.display = (val === 'dislike') ? 'block' : 'none';
+  }
+  // Save vote to feedback
+  dashboardPaneFeedbacks[paneIndex] = dashboardPaneFeedbacks[paneIndex] || '';
+  savePaneVote(paneIndex, val);
+}
+function savePaneVote(paneIndex, vote) {
